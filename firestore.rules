rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ───────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // ─── Admins: full access to everything ──────────────────────
    match /{document=**} {
      allow read, write: if isAuth() && getRole() == 'admin';
    }

    // ─── Users: read own profile, admins read all ───────────────
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || getRole() == 'admin');
      allow write: if isAuth() && getRole() == 'admin';
    }

    // ─── Settings: only admins can write ────────────────────────
    match /settings/{doc} {
      allow read: if isAuth();
    }

    // ─── Classes, Subjects: authenticated users can read ────────
    match /classes/{doc} {
      allow read: if isAuth();
    }
    match /subjects/{doc} {
      allow read: if isAuth();
    }

    // ─── Students: teachers can read/write, others read ────────
    match /students/{doc} {
      allow read: if isAuth();
      allow write: if isAuth() && getRole() in ['teacher'];
    }

    // ─── Results: teachers can read/write, others read ──────────
    match /results/{doc} {
      allow read: if isAuth();
      allow write: if isAuth() && getRole() in ['teacher'];
    }

    // ─── Attendance: teachers can read/write, others read ──────
    match /attendance/{doc} {
      allow read: if isAuth();
      allow write: if isAuth() && getRole() in ['teacher'];
    }

    // ─── Promotions: teachers can read, admins can write ────────
    match /promotions/{doc} {
      allow read: if isAuth();
      allow write: if isAuth() && getRole() == 'admin';
    }
  }
}
