rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ───────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function getRole() {
      let doc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      // Null-safe: a missing/unreadable profile must never crash the rule —
      // it simply denies the operation (secure by default).
      return doc != null && doc.data != null ? doc.data.role : null;
    }

    // Returns the teacher's assigned class names array.
    // Falls back to empty array if field doesn't exist yet (migration period).
    // Secure by default: teachers without assigned classes cannot write anything.
    function getTeacherClasses() {
      let doc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let classes = doc != null && doc.data != null ? doc.data.teacherClasses : null;
      return classes == null || classes[0] == null ? [] : classes;
    }

    // Check if a className is in the teacher's assigned classes.
    function isTeacherAssignedClass(className) {
      let allowed = getTeacherClasses();
      return getRole() == 'teacher' && className in allowed;
    }

    // Returns the teacher's assigned subject ID array.
    // Falls back to empty array if the field doesn't exist yet.
    function getTeacherSubjects() {
      let doc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let subs = doc != null && doc.data != null ? doc.data.teacherSubjects : null;
      return subs == null || subs[0] == null ? [] : subs;
    }

    // Check if a subjectId is in the teacher's assigned subjects AND the
    // subject actually belongs to the record's class. The subjectId must be
    // non-empty: combined with the class-OR in the results write rule,
    // allowing blank IDs here would let a teacher save results for ANY class,
    // bypassing the class restriction entirely.
    // NOTE: rules functions only allow `let` + a single `return` expression,
    // so the guard and the class check are chained with short-circuit &&.
    function isTeacherAssignedSubject(subjectId, className) {
      let subs = getTeacherSubjects();
      return getRole() == 'teacher'
        && subjectId != null && subjectId != ''
        && subjectId in subs
        && get(/databases/$(database)/documents/subjects/$(subjectId)).data != null
        && get(/databases/$(database)/documents/subjects/$(subjectId)).data.className == className;
    }

    // Returns the teacher's assigned sexes (Male/Female).
    // Falls back to empty array if field doesn't exist yet (migration period).
    // Secure by default: teachers without assigned sexes cannot save results.
    function getTeacherSexes() {
      let doc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      let sexes = doc != null && doc.data != null ? doc.data.teacherSexes : null;
      return sexes == null || sexes[0] == null ? [] : sexes;
    }

    // True if the teacher may record results for students of the given sex.
    // A missing/empty sex is also allowed so teachers are never blocked from
    // saving results for students whose profile has no sex value yet.
    function isTeacherAssignedSex(sex) {
      let allowed = getTeacherSexes();
      return getRole() == 'teacher' && (sex == null || sex == '' || sex in allowed);
    }

    // ─── Admins: full access to everything ──────────────────────
    match /{document=**} {
      allow read, write: if isAuth() && getRole() == 'admin';
    }

    // ─── Users: read own profile, admins read all ───────────────
    match /users/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || getRole() == 'admin');
      allow write: if isAuth() && getRole() == 'admin';
    }

    // ─── Settings: anyone can read, admin-only write ───────────────
    match /settings/{doc} {
      allow read: if true;  // public for report card page
    }

    // ─── Classes, Subjects: anyone can read ─────────────────────
    match /classes/{doc} {
      allow read: if true;  // public for report card page
    }
    match /subjects/{doc} {
      allow read: if true;  // public for report card page
    }

    // ─── Students: public read, admin-only write ──────────────────
    match /students/{doc} {
      allow read: if true;  // public for report card lookup by studentId
      allow write: if isAuth() && getRole() == 'admin';
    }

    // ─── Results: teachers restricted to assigned classes & sexes ─
    // A write passes if the teacher is assigned to the record's class OR its
    // subject (subjectId must be non-empty), AND the sex check passes. The
    // subject path mirrors what the teacher UI actually filters on
    // (teacherSubjects), so a stale teacherClasses array can never lock a
    // teacher out of saving.
    match /results/{doc} {
      allow read: if isAuth();
      allow write: if isAuth() && (
        getRole() == 'admin' ||
        (isTeacherAssignedSex(request.resource.data.sex) &&
         (isTeacherAssignedClass(request.resource.data.className) ||
          isTeacherAssignedSubject(request.resource.data.subjectId, request.resource.data.className)))
      );
    }

    // ─── Attendance: teachers restricted to assigned classes ────
    match /attendance/{doc} {
      allow read: if isAuth();
      allow write: if isAuth() && (
        getRole() == 'admin' ||
        isTeacherAssignedClass(request.resource.data.className)
      );
    }

    // ─── Promotions: teachers can read, admins can write ────────
    match /promotions/{doc} {
      allow read: if isAuth();
      allow write: if isAuth() && getRole() == 'admin';
    }

    // ─── Audit Logs: append-only, admin-readable only ──────────
    match /auditLogs/{doc} {
      allow read: if isAuth() && getRole() == 'admin';
      allow create: if isAuth();
      allow update, delete: if false;  // immutable — no edits or deletions
    }

    // ─── Payments: append-only for authenticated users, admin-readable ──
    match /payments/{doc} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if false;  // immutable — no edits or deletions
    }
  }
}
